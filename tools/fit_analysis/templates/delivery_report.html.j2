<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MarathonCoach Custom Analysis</title>
  <style>
    :root {
      --bg: #f6f2e8;
      --paper: #fffdf8;
      --ink: #1f2a2e;
      --muted: #5d6a70;
      --line: #d8d0c2;
      --accent: #aa5f2c;
      --accent-soft: #f5e2d2;
    }
    body {
      margin: 0;
      background: linear-gradient(160deg, #f1ece1 0%, #faf7ef 55%, #efe8d8 100%);
      color: var(--ink);
      font-family: "Hiragino Sans", "Yu Gothic", sans-serif;
      line-height: 1.6;
    }
    main {
      max-width: 920px;
      margin: 32px auto;
      padding: 28px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 20px 60px rgba(43, 35, 22, 0.08);
    }
    h1, h2 {
      margin: 0 0 12px;
      line-height: 1.2;
    }
    h1 {
      font-size: 2rem;
    }
    h2 {
      margin-top: 28px;
      font-size: 1.2rem;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--accent-soft);
    }
    .meta {
      color: var(--muted);
      margin-bottom: 18px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }
    th, td {
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    th {
      background: #fbf5ec;
      font-weight: 700;
    }
    ul {
      padding-left: 20px;
    }
    code {
      display: inline-block;
      padding: 4px 8px;
      background: #f3efe6;
      border-radius: 6px;
      font-size: 0.95rem;
    }
    .code-block {
      display: inline-block;
      padding: 10px 14px;
      background: #f3efe6;
      border: 1px solid var(--line);
      border-radius: 10px;
      font-size: 1.1rem;
      letter-spacing: 0.06em;
    }
  </style>
</head>
<body>
  <main>
    <h1>MarathonCoach Custom Analysis</h1>
    <div class="meta">${meta_html}</div>

    <h2>目標</h2>
    ${goal_html}

    <h2>基準設定と個別設定</h2>
    ${zone_table_html}

    <h2>適用した補正</h2>
    ${adjustment_html}

    <h2>数値つき理由</h2>
    ${reason_html}

    <h2>説明用7項目</h2>
    ${summary_html}

    <h2>ヒアリング反映</h2>
    ${hearing_html}

    <h2>レース中の見方</h2>
    ${race_usage_html}

    <h2>専用設定コード</h2>
    <div class="code-block">${custom_code}</div>

    <h2>再調整メモ</h2>
    ${recalibration_html}
  </main>
</body>
</html>
